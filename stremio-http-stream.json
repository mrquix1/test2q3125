{
  "id": "stremio-http-stream",
  "name": "Stremio HTTP Streams (Series & Cartoons)",
  "description": "Resolves direct HTTP/HLS streams for Western cartoons & series (like The Boondocks) via Simkl + any Stremio HTTP Stream Addon.",
  "manifestURI": "https://raw.githubusercontent.com/mrquix1/test2q3125/main/stremio-http-stream.json",
  "version": "1.0.1",
  "author": "mrquix1",
  "type": "onlinestream-provider",
  "language": "typescript",
  "lang": "en",
  "payloadURI": "https://raw.githubusercontent.com/mrquix1/test2q3125/main/stremio-http-stream.ts",
  "userConfig": {
    "requiresConfig": true,
    "version": 1,
    "fields": [
      {
        "type": "text",
        "name": "simklClientId",
        "label": "Simkl Client ID",
        "default": ""
      },
      {
        "type": "text",
        "name": "addonBaseUrl",
        "label": "Stremio Stream Addon Base URL (without /manifest.json)",
        "default": ""
      }
    ]
  }
}
